# ---- Obligatorio ----
# Token de un bot NUEVO creado con @BotFather (no reutilices el de Anime-Automator)
TELEGRAM_BOT_TOKEN=
# Chat sin restricciones; recibe y aprueba las peticiones de los demás (usa /id para verlo)
ADMIN_CHAT_ID=

# ---- Acceso ----
# Chats permitidos, separados por comas. Si hay alguno, SOLO esos (y el admin) pueden usar el bot.
ALLOWED_CHAT_IDS=
# Si ALLOWED_CHAT_IDS está vacío: palabra clave para darse de alta con "/start <palabra>".
# Si también está vacía, el bot queda abierto a cualquiera (con aviso disuasorio).
ACCESS_KEYWORD=

# ---- Límites ----
WEEKLY_LIMIT=3

# ---- Servicios (normalmente no hace falta tocarlos) ----
# Red Docker del stack de Anime-Automator (la crea su compose: <carpeta>_default)
AUTOMATOR_NETWORK=anime-automator_default
ANIME_AUTOMATOR_URL=http://anime-automator:5000
SOCKPUPPET_URL=ws://browser-sockpuppet-chrome:3000
JAPANPAW_BASE=https://japanpaw.com
# 1 = usar siempre el navegador para japanpaw (depuración)
FORCE_BROWSER=0
# Si la web nos bloquea (403, o certificado falso de LaLiga sin otra IP libre), se usa
# este proxy durante 6 h para ese servidor. Tor: socks5://IP:9050 (vacío = sin proxy)
BLOCK_BYPASS_PROXY=
TZ=Europe/Madrid

# ---- Avisos de progreso desde Anime-Automator ----
# Debe coincidir con REQUESTER_CALLBACK_SECRET del .env de Anime-Automator
CALLBACK_SECRET=
EVENTS_PORT=8080

# ---- Seguimiento semanal de lo que está en emisión (change-detection.io) ----
# Sin URL o sin clave no se ofrece el seguimiento. La clave está en Settings > API.
CHANGEDETECTION_URL=
CHANGEDETECTION_API_KEY=
# Etiqueta con la que se crean los seguimientos (se crea sola si no existe)
CHANGEDETECTION_TAG=kuro
# Vacío = el método de descarga por defecto de change-detection; p. ej. html_webdriver
CHANGEDETECTION_FETCH_BACKEND=
# Vacío = los avisos que tengas configurados en change-detection (globales o de la etiqueta).
# Si no, p. ej. jsons://IP-DEL-MINIPC:5000/webhook (se manda {"watch_url", "watch_title"})
CHANGEDETECTION_NOTIFY_URL=
# Seguimientos activos (o pendientes de aprobar) por cliente; el admin no tiene límite
TRACKING_LIMIT=2
# Ventana de comprobación desde la hora de emisión (como mucho 24 h), y cada cuánto
# mira change-detection dentro de ella (el Drive lo mira Anime-Automator, cada 10 min)
TRACKING_WINDOW_HOURS=24
# Quién vigila los capítulos nuevos (ver «Del change-detection al Drive» en el README):
#   changedetection,drive  los dos a la vez (fase 1)
#   drive                  solo el Drive; Kuro borra los watches que creó en change-detection (fase 3)
TRACKING_SOURCES=changedetection,drive
TRACKING_CHECK_MINUTES=60

# Pedir por torrent lo que no está en la web (Anime-Automator lo busca: Erai-raws primero, nunca
# sin subtítulos en español): off, admin (solo tú) o all (también los clientes, con tu visto bueno)
TORRENT_ACCESS=admin
# Sinopsis en español de lo que se pide por torrent (clave v3 o token v4 de themoviedb.org, gratis).
# Sin ella, la de AniList en inglés.
TMDB_API_KEY=

# Animes que los clientes no pueden pedir (separados por comas; basta con que el título los contenga).
# Sin definir: One Piece y Naruto. Vacío: ninguno. El admin siempre puede.
BLOCKED_ANIME=One Piece,Naruto
